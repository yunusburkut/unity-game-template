#!/bin/bash
#
# Refuses a commit that adds an asset without its .meta file, or a .meta without its asset (a missing .meta
# makes Unity mint a new GUID on the next machine and breaks every reference to the asset).
# new-game.ps1 enables it with: git config core.hooksPath .githooks
#
# From https://github.com/doitian/unity-git-hooks (scripts/pre-commit), unchanged below this header.
#
