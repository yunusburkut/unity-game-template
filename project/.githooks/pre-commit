ASSETS_DIR="$(git config --get unity3d.assets-dir || echo "Assets")"

if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=4b825dc642cb6eb9a060e54bf8d69288fbee4904
fi

# Redirect output to stderr.
exec 1>&2

# in_index PATH: PATH is a file in the index, or a directory holding one (what `git ls-files -- PATH` reported).
if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
	declare -A indexed
	while IFS= read -r -d $'\0' path; do
		indexed["$path"]=1
		d="$path"
		while [ "${d%/*}" != "$d" ]; do
			d="${d%/*}"
			[ -n "${indexed["$d"]}" ] && break
			indexed["$d"]=1
		done
	done < <(git ls-files --cached -z -- "$ASSETS_DIR")
	in_index() { [ -n "${indexed["$1"]}" ]; }
else
	in_index() { [ "$(git ls-files --cached -- "$1" | wc -l)" != 0 ]; }
fi

git -c diff.renames=false diff --cached --name-only --diff-filter=A -z $against -- "$ASSETS_DIR" | while read -d $'\0' f; do
	ext="${f##*.}"
	base="${f%.*}"
	filename="$(basename "$f")"

	if [ "$ext" = "meta" ]; then
		if ! in_index "$base"; then
			cat <<EOF
Error: Redudant meta file. Meta file '$f' is added, but '$base' is not in the git index.
Please add '$base' to git as well.
EOF
			exit 1
		fi
	elif [ "${filename##.*}" != '' ]; then
		p="$f"
		while [ "$p" != "$ASSETS_DIR" ]; do
			if ! in_index "$p.meta"; then
				cat <<EOF
Error: Missing meta file. Asset '$f' is added, but '$p.meta' is not in the git index.
Please add '$p.meta' to git as well by typing the following:
git add '$p.meta'
EOF
				exit 1
			fi
			p="${p%/*}"
		done
	fi
done

ret="$?"
if [ "$ret" != 0 ]; then
	exit "$ret"
fi

git -c diff.renames=false diff --cached --name-only --diff-filter=D -z $against -- "$ASSETS_DIR" | while read -d $'\0' f; do
	ext="${f##*.}"
	base="${f%.*}"

	if [ "$ext" = "meta" ]; then
		if in_index "$base"; then
			cat <<EOF
Error: Missing meta file. Meta file '$f' is removed, but '$base' is still in the git index.
Please revert the meta file or remove the asset file.
EOF
			exit 1
		fi
	else
		p="$f"
		while [ "$p" != "$ASSETS_DIR" ]; do
			if ! in_index "$p" && in_index "$p.meta"; then
				cat <<EOF
Error: Redudant meta file. Asset '$f' is removed, but '$p.meta' is still in the git index.
Please remove '$p.meta' from git as well by typing the following: 
git rm '$p.meta'
EOF
				exit 1
			fi
			p="${p%/*}"
		done
	fi
done

ret="$?"
if [ "$ret" != 0 ]; then
	exit "$ret"
fi
