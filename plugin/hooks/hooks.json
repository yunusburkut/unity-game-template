                  "PostToolUse":  [
                                      {
                                          "matcher":  "Edit|Write|Bash|PowerShell",
                                          "hooks":  [
                                                        {
                                                            "type":  "command",
                                                            "if":  "Bash(git rm *)",
                                                            "shell":  "bash",
                                                            "command":  "d=\"${CLAUDE_PROJECT_DIR:-.}/Logs/agent\"; [ -f \"$d/bridge.log\" ] && [ ! -s \"$d/request.txt\" ] && printf 'refresh\\n' > \"$d/request.txt\"; exit 0",
                                                            "timeout":  5
                                                        },
                                                        {
                                                            "type":  "command",
                                                            "if":  "Bash(git mv *)",
                                                            "shell":  "bash",
                                                            "command":  "d=\"${CLAUDE_PROJECT_DIR:-.}/Logs/agent\"; [ -f \"$d/bridge.log\" ] && [ ! -s \"$d/request.txt\" ] && printf 'refresh\\n' > \"$d/request.txt\"; exit 0",
                                                            "timeout":  5
                                                        },
                                                        {
