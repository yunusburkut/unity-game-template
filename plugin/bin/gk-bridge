#!/usr/bin/env bash
# gk-bridge (gamekit plugin, on the Bash tool's PATH): one GameKit AgentBridge request, sent and waited for, so every
# pipeline gate is one command instead of a hand-written poll loop.
#
#   gk-bridge refresh                  import + compile; pass = compile.log clean AND newer than every .cs/.asmdef
#   gk-bridge fresh                    read-only: refresh's verdict on the last refresh, nothing sent to Unity
#                                      (is compile.log the current code's? reviewers run this; no Editor needed)
#   gk-bridge compile android|ios|webgl  type-check the #if UNITY_ANDROID / UNITY_IOS / UNITY_WEBGL code
#                                      (compile-player.log; webgl needs GameKit 0.1.3+, older ones answer unknown)
#   gk-bridge play-capture [seconds]   enter Play Mode, 3 screenshots + errors, leave (capture.log)
#   gk-bridge run-tests [playmode]     refresh gate, then the whole EditMode / PlayMode suite  - ask first, background
#   gk-bridge build <target> [dev]     windows|android|aab|ios|webgl (build.log)               - ask first, background
#   -t <seconds>                       deadline: default 110 (fits the Bash tool's 120 s), run-tests 600, build 1200
#                                      (run-tests: its refresh gate gets its own -t first, then the tests get theirs)
#
# Prints "gk-bridge: PASS|FAIL|UNKNOWN <request> (<n>s)" and the log head.
# Exit 0 = pass, 1 = fail (the log says why), 2 = unknown (no Editor, Play Mode, busy, timeout, stale compile, a
# request this game's AgentBridge does not know, a test run where 0 tests passed, bad usage). 2 is never a pass.
# Environment (tests and the run-tests self-call only, never set by hand): GK_BRIDGE_ROOT replaces the git top level
# as the project root; GK_BRIDGE_EDITOR_OK=1 skips the Editor lock probe (one PowerShell start), because the caller
# already ran it or a fixture stands in for the Editor.
# Ceiling: compile freshness compares file times only, and a script saved before the request whose compile starts
# after AgentBridge's settle time (2 s, plus 8 s once when a script is newer than compile.log) reads as "no script
# changes" (one saved after the request reads as unknown); the Editor is detected through Temp/UnityLockfile, so an
# Editor stuck behind a modal dialog shows up as a request never taken.
set -u

usage() { grep -e '^#   gk-bridge ' -e '^#   -t ' -e '^#                                      (' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
timeout=''
if [ "${1:-}" = '-t' ]; then
    [ $# -ge 2 ] || usage
    timeout=$2; shift 2
    case "$timeout" in ''|*[!0-9]*) usage ;; esac
fi
req="$*"
ro=""
case "$req" in
    refresh)                         log=bridge.log ;;
    fresh)                           log=bridge.log; ro=1 ;;
    'compile android'|'compile ios'|'compile webgl') log=compile-player.log ;;
    run-tests|'run-tests playmode')  log=tests.log; : "${timeout:=600}" ;;
    *)  if [[ $req =~ ^play-capture(\ [0-9]+)?$ ]]; then log=capture.log
        elif [[ $req =~ ^build\ [a-z]+(\ dev)?$ ]]; then log=build.log; : "${timeout:=1200}"   # AgentBridge checks the target (BuildMenu.TargetNames)
        else usage; fi ;;
esac
: "${timeout:=110}"

root=${GK_BRIDGE_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
d="$root/Logs/agent"
say() { printf 'gk-bridge: %s\n' "$*"; }
unknown() { say "UNKNOWN $req - $*"; exit 2; }

[ -f "$root/ProjectSettings/ProjectVersion.txt" ] || unknown "not a Unity project root ($root)"
gamekit() { grep -q 'com\.yunusburkut\.gamekit' "$root/Packages/manifest.json" 2>/dev/null; }
if [ ! -f "$d/compile.log" ]; then
    # Logs/ is not committed, so a fresh clone has no compile.log yet even with a bridge: GameKit, or a game's own copy
    # in any Editor folder under Assets (Assets/<Game>/Scripts/Editor too); Feel, most of Assets, is skipped
    { gamekit || find "$root/Assets" -path "$root/Assets/Feel" -prune -o -path '*/Editor/AgentBridge.cs' -print -quit 2>/dev/null | grep -q .; } &&
        unknown "no Logs/agent/compile.log: open the project in Unity once (its AgentBridge writes it)"
    unknown "this project has no AgentBridge (no GameKit, no Logs/agent/compile.log), so nothing can gate here: ask the user to focus Unity and read the Console, and call the compile unverified"
fi

editor_open() {
    local lock="$root/Temp/UnityLockfile" w
    [ -f "$lock" ] || return 1
    w=$(cygpath -w "$lock"); w=${w//\'/\'\'}   # inside a PowerShell '...' string an apostrophe is doubled
    # Unity holds the lock file open without sharing; a stale file from a crashed Editor opens fine
    powershell.exe -NoProfile -NonInteractive -Command \
        "try { [IO.File]::Open('$w','Open','Read','None').Dispose(); exit 1 } catch { exit 0 }" >/dev/null 2>&1
}
[ -n "$ro" ] || [ "${GK_BRIDGE_EDITOR_OK:-}" = 1 ] || editor_open || unknown "Unity Editor is not running on this project: open it (compile state cannot be checked)"

mtime() { stat -c %Y "$1" 2>/dev/null || echo 0; }
first() { head -1 "$1" 2>/dev/null | tr -d '\r'; }

started=$(date +%s)
deadline=$((started + timeout))
take=$(( timeout < 90 ? timeout : 90 ))   # how long the Editor may take to pick a request up
cap() { [ "$1" -lt "$deadline" ] && echo "$1" || echo "$deadline"; }   # no wait outlives -t

# run-tests does not import first (AgentBridge.cs), so stale code would be tested: gate on a refresh before it. Every
# GameKit knows refresh; a game's own copy knows it once bridge.log exists (GameKit 0.1.1+ writes it at Editor start,
# older bridges on their first refresh, and the oldest copies never): without either, the tests run ungated.
gate=''
if [ "$log" = tests.log ]; then
    if [ -f "$d/bridge.log" ] || gamekit; then GK_BRIDGE_ROOT="$root" GK_BRIDGE_EDITOR_OK=1 "$0" -t "$timeout" refresh || exit $?
    else gate=' (no refresh gate: no GameKit and no bridge.log, so this AgentBridge copy may not know refresh and the compile was not checked first)'; fi
fi
started=$(date +%s)   # the pickup window and the deadline start after the gate: a long import there costs the tests nothing
deadline=$((started + timeout))

# fresh sends nothing: the last refresh's answer is judged as it stands, bridge.log's time standing in for its
# request's (the block up to "fi # request" is the request path, left unindented)
if [ -n "$ro" ]; then t0=$(mtime "$d/bridge.log"); else

# one request at a time: a build in progress keeps request.txt unread until it ends
case "$(first "$d/build.log")" in PENDING*) unknown "a build is running (build.log PENDING); wait for it (PENDING for over 20 min: a build that never started, restarting Unity closes it)" ;; esac
case "$(first "$d/capture.log")" in PENDING*) unknown "a play-capture is running (capture.log PENDING); wait for it (one whose Play Mode never starts ends FAILED after 30 s; restarting Unity closes one that never ends)" ;; esac
# a refresh or capture under a running test job would test a mix of old and new code; AgentBridge also holds requests
# then. A RUNNING line not written for $hold s is a run that never reported: not a reason to wait. The hold is
# AgentBridge.TestRunOpen's AddMinutes(-10) (packages/com.yunusburkut.gamekit/Editor/AgentBridge.cs); change both together.
hold=600
case "$(first "$d/tests.log")" in RUNNING*)
    [ $(( $(date +%s) - $(mtime "$d/tests.log") )) -lt $hold ] &&
        unknown "a test run is in progress (tests.log RUNNING); wait for its result (a run cancelled in Unity's Test Runner window holds this up to $((hold / 60)) min; restarting Unity clears it)" ;;
esac
joined=0
while [ -e "$d/request.txt" ]; do
    pending=$(tr -d '\r\n' < "$d/request.txt" 2>/dev/null)
    # the PostToolUse hook queues a refresh after script edits: ours is the same request, so wait on that one
    if [ "$pending" = "$req" ]; then joined=1; break; fi
    [ "$(date +%s)" -lt "$(cap $((started + take)))" ] || unknown "request.txt still holds '$pending' after $take s: the Editor is busy, in a modal dialog or in Safe Mode"
    sleep 1
done
# joined: the hook's request was still unread after we started, so any answer from now on is to it
t0=$started
if [ "$joined" = 0 ] || [ ! -e "$d/request.txt" ]; then
    t0=$(date +%s); printf '%s\n' "$req" > "$d/request.txt"   # also when the Editor took the hook's request just now
fi

# the Editor polls once a second, but an import or domain reload holds it for longer
while [ -e "$d/request.txt" ]; do
    # a build queued after the check above holds request.txt until it ends: say so, not "busy" (our own build writes
    # PENDING the moment it is taken, so a build request skips this)
    if [ "$log" != build.log ]; then case "$(first "$d/build.log")" in PENDING*)
        [ "$(tr -d '\r\n' < "$d/request.txt" 2>/dev/null)" = "$req" ] && rm -f "$d/request.txt"
        unknown "a build is running (build.log PENDING); wait for it (PENDING for over 20 min: a build that never started, restarting Unity closes it)" ;; esac; fi
    if [ "$(date +%s)" -ge "$(cap $((t0 + take)))" ]; then
        [ "$(tr -d '\r\n' < "$d/request.txt" 2>/dev/null)" = "$req" ] && rm -f "$d/request.txt"
        unknown "the Editor did not take the request in $take s: busy, a modal dialog or Safe Mode (look at Unity)"
    fi
    sleep 1
done
sleep 0.2   # the Editor deletes request.txt just before it writes the state line: never read the log in that gap

# wait until the target log is newer than the request and no longer says it is running; an AgentBridge that does not
# know the request answers "Unknown request" in bridge.log (GameKit) or tests.log (copies older than GameKit)
while :; do
    for f in bridge.log tests.log; do
        if [ "$(mtime "$d/$f")" -ge "$t0" ]; then
            case "$(first "$d/$f")" in 'Unknown request'*)
                unknown "this game's AgentBridge does not know '$req' ($f): use the check the game's CLAUDE.md names" ;;
            esac
        fi
    done
    if [ "$(mtime "$d/$log")" -ge "$t0" ]; then
        case "$(first "$d/$log")" in REFRESHING*|RUNNING*|PENDING*) ;; *) break ;; esac
    fi
    [ "$(date +%s)" -lt "$deadline" ] || unknown "no answer in $timeout s; $log says: $(first "$d/$log")"
    sleep 1
done
fi # request

secs=$(( $(date +%s) - started ))
status=$(first "$d/$log")
out=$log
verdict=PASS
case "$log" in
    bridge.log)
        newer=(-newer "$d/compile.log"); since="compile.log ($(first "$d/compile.log")) is older than"
        case "$status" in
            *'in Play Mode'*|SKIPPED*) verdict=UNKNOWN ;;
            REFRESHED*)
                # "no script changes": the import saw every edit saved before the request and none needed a compile;
                # one saved after it (during the settle wait, before bridge.log) was not in that import
                case "$status" in *'no script changes'*)
                    newer=(-newermt "@$t0"); since="the refresh saw no script changes, but this was saved after its request:" ;; esac
                out=compile.log; status=$(first "$d/compile.log")
                case "$status" in
                    OK*|'0 error(s)'*) ;;
                    *) verdict=FAIL ;;
                esac ;;
            *) verdict=UNKNOWN ;;
        esac
        if [ "$verdict" = PASS ]; then
            stale=$(find "$root/Assets" "$root/Packages" -path "$root/Assets/Feel" -prune -o \
                \( -name '*.cs' -o -name '*.asmdef' -o -name '*.asmref' \) "${newer[@]}" -print 2>/dev/null | head -1)
            if [ -n "$stale" ]; then
                verdict=UNKNOWN
                status="$since ${stale#"$root/"}: that edit has not been compiled"
            fi
        fi ;;
    # the platform must match: another caller's compile of the other platform can answer in the same log
    compile-player.log) case "$status" in "OK  ${req#compile }"*) ;; "FAILED  ${req#compile }"*) verdict=FAIL ;;
                            *) verdict=UNKNOWN ;; esac ;;
    # AgentBridge writes "<TestStatus>  <n> passed, ...": a pass with no test run (empty or filtered suite) proves nothing
    tests.log)          case "$status" in Passed*' 0 passed,'*) verdict=UNKNOWN; status="$status (no test ran: nothing was proved)" ;;
                            Passed*) ;; Failed*|FAILED*) verdict=FAIL ;; *) verdict=UNKNOWN ;; esac ;;
    capture.log)        case "$status" in OK*) ;; ERRORS*|'COMPILE FAILED'*|FAILED*) verdict=FAIL ;; *) verdict=UNKNOWN ;; esac ;;
    build.log)          case "$status" in Succeeded*) ;; Failed*|FAILED*|Cancelled*) verdict=FAIL ;; *) verdict=UNKNOWN ;; esac ;;
esac
# a closed Editor or a missing platform module is not a code failure
case "$status" in *'Editor restarted'*|*'module is not installed'*) [ "$verdict" = FAIL ] && verdict=UNKNOWN ;; esac

say "$verdict $req (${secs}s): $status${gate:-}"
head -n 25 "$d/$out" | tail -n +2
[ "$log" = capture.log ] && [ "$verdict" != UNKNOWN ] && echo "screenshots: Logs/agent/capture/ (look at them: a blank or one-colour shot is a fail)"
case "$verdict" in PASS) exit 0 ;; FAIL) exit 1 ;; *) exit 2 ;; esac
